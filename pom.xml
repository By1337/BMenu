<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>dev.by1337.bmenu</groupId>
    <artifactId>BMenu</artifactId>
    <version>2.9.1</version>

    <properties>
        <java.version>16</java.version>
        <bpatch.version>1.0.0</bpatch.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <distributionManagement>
        <repository>
            <id>by1337.repo.2</id>
            <name>releases</name>
            <url>https://repo.by1337.space/repository/maven-releases/</url>
        </repository>
        <snapshotRepository>
            <id>by1337.repo.2</id>
            <name>snapshots</name>
            <url>https://repo.by1337.space/repository/maven-snapshots/</url>
        </snapshotRepository>
    </distributionManagement>

    <pluginRepositories>
        <pluginRepository>
            <id>by1337-repo</id>
            <url>https://repo.by1337.space/repository/maven-releases/</url>
        </pluginRepository>
    </pluginRepositories>


    <build>
        <defaultGoal>clean install</defaultGoal>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.0</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                </configuration>
            </plugin>
            <plugin>
                <groupId>dev.by1337.bpatch</groupId>
                <artifactId>bpatch-maven-plugin</artifactId>
                <version>${bpatch.version}</version>
                <executions>
                    <execution>
                        <id>pack-legacy-bmenu</id>
                        <goals>
                            <goal>pack</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <jars>
                        <jar>
                            <artifact>org.by1337.bmenu:BMenu:1.7+legacy</artifact>
                            <output>bridges/BMenu-1.7+legacy.jar</output>
                            <compression>STORED</compression>
                        </jar>
                    </jars>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <paperweight-mappings-namespace>mojang</paperweight-mappings-namespace>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.4</version>
                <configuration>
                    <systemPropertyVariables>
                        <bmenu.generatedConfigs>${project.build.directory}/generated-configs</bmenu.generatedConfigs>
                    </systemPropertyVariables>
                    <!-- Keep the 1.16 API on the compiler path; use EventDSL's parser API only in tests. -->
                    <classpathDependencyExcludes>
                        <classpathDependencyExclude>net.kyori:adventure-api</classpathDependencyExclude>
                        <classpathDependencyExclude>net.kyori:adventure-key</classpathDependencyExclude>
                    </classpathDependencyExcludes>
                    <additionalClasspathDependencies>
                        <additionalClasspathDependency>
                            <groupId>net.kyori</groupId>
                            <artifactId>adventure-api</artifactId>
                            <version>4.20.0</version>
                        </additionalClasspathDependency>
                    </additionalClasspathDependencies>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.2.0</version>
                <executions>
                    <execution>
                        <id>generate-localized-configs</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <macrodef name="localized-configs">
                                    <attribute name="locale"/>
                                    <attribute name="exclude-locale"/>
                                    <sequential>
                                        <copy todir="${project.build.directory}/generated-configs/@{locale}"
                                              overwrite="true" encoding="UTF-8" outputencoding="UTF-8">
                                            <fileset dir="${project.basedir}/src/main/config-templates"/>
                                            <filterchain>
                                                <linecontainsregexp negate="true">
                                                    <regexp pattern=" # @locale:@{exclude-locale}$"/>
                                                </linecontainsregexp>
                                                <tokenfilter>
                                                    <replaceregex pattern=" # @locale:@{locale}$" replace=""/>
                                                </tokenfilter>
                                            </filterchain>
                                        </copy>
                                    </sequential>
                                </macrodef>
                                <!-- Recreate both generated directories on every build. -->
                                <delete dir="${project.build.directory}/generated-configs"/>
                                <localized-configs locale="ru" exclude-locale="en"/>
                                <localized-configs locale="en" exclude-locale="ru"/>
                                <fail message="Unknown or malformed locale marker in generated configs">
                                    <condition>
                                        <resourcecount when="greater" count="0">
                                            <restrict>
                                                <fileset dir="${project.build.directory}/generated-configs"/>
                                                <containsregexp expression="@locale:"/>
                                            </restrict>
                                        </resourcecount>
                                    </condition>
                                </fail>
                                <!-- Keep the unclassified artifact and test classpath compatible with the RU defaults. -->
                                <copy todir="${project.build.outputDirectory}" overwrite="true">
                                    <fileset dir="${project.build.directory}/generated-configs/ru"/>
                                </copy>
                            </target>
                        </configuration>
                    </execution>
                    <execution>
                        <id>package-localized-jars</id>
                        <phase>package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <macrodef name="localized-jar">
                                    <attribute name="locale"/>
                                    <sequential>
                                        <zip destfile="${project.build.directory}/${project.build.finalName}-@{locale}.jar"
                                             duplicate="fail" keepcompression="true">
                                            <zipfileset src="${project.build.directory}/${project.build.finalName}.jar">
                                                <patternset>
                                                    <excludesfile name="${project.build.directory}/localized-config-paths.txt"/>
                                                </patternset>
                                            </zipfileset>
                                            <fileset dir="${project.build.directory}/generated-configs/@{locale}"/>
                                        </zip>
                                    </sequential>
                                </macrodef>
                                <pathconvert property="localized.config.paths" pathsep="${line.separator}">
                                    <fileset dir="${project.basedir}/src/main/config-templates"/>
                                    <map from="${project.basedir}/src/main/config-templates/" to=""/>
                                </pathconvert>
                                <echo file="${project.build.directory}/localized-config-paths.txt"
                                      encoding="UTF-8">${localized.config.paths}</echo>
                                <localized-jar locale="ru"/>
                                <localized-jar locale="en"/>
                                <attachartifact file="${project.build.directory}/${project.build.finalName}-ru.jar"
                                                classifier="ru" type="jar"/>
                                <attachartifact file="${project.build.directory}/${project.build.finalName}-en.jar"
                                                classifier="en" type="jar"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
    </build>


    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <repository>
            <id>spigotmc-repo</id>
            <url>https://hub.spigotmc.org/nexus/content/repositories/snapshots/</url>
        </repository>
        <repository>
            <id>sonatype</id>
            <url>https://oss.sonatype.org/content/groups/public/</url>
        </repository>
        <repository>
            <id>minecraft-repo</id>
            <url>https://libraries.minecraft.net/</url>
        </repository>
        <repository>
            <id>by1337-repo</id>
            <url>https://repo.by1337.space/repository/maven-releases/</url>
        </repository>
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>com.destroystokyo.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>1.16.5-R0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>dev.by1337.core</groupId>
            <artifactId>BLibV2</artifactId>
            <version>1.10.12</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>it.unimi.dsi</groupId>
            <artifactId>fastutil</artifactId>
            <version>8.5.15</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>com.github.MilkBowl</groupId>
            <artifactId>VaultAPI</artifactId>
            <version>1.7</version>
            <scope>provided</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.bukkit</groupId>
                    <artifactId>bukkit</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
            <version>33.2.1-jre</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.mojang</groupId>
            <artifactId>authlib</artifactId>
            <version>1.5.21</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.mojang</groupId>
            <artifactId>brigadier</artifactId>
            <scope>provided</scope>
            <version>1.0.18</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>2.0.16</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.jetbrains</groupId>
            <artifactId>annotations</artifactId>
            <version>24.1.0</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.google.errorprone</groupId>
            <artifactId>error_prone_annotations</artifactId>
            <scope>provided</scope>
            <version>2.23.0</version>
        </dependency>
        <!-- tests -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>5.7.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>5.7.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>3.7.7</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <version>3.7.7</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-inline</artifactId>
            <version>3.7.7</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>2.0.16</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.kyori</groupId>
            <artifactId>adventure-text-minimessage</artifactId>
            <version>4.20.0</version>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>net.kyori</groupId>
                    <artifactId>adventure-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>

</project>
